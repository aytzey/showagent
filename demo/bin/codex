#!/bin/sh
# Demo stub for the Codex CLI. It exists only so the demo GIF can show a
# resume without launching a real agent. showagent execs `codex resume <id>`
# in the session workspace; this prints a plausible one-screen mock and idles
# until the recording stops it.

sid=""
for arg in "$@"; do
	sid="$arg"
done
short=$(printf '%s' "$sid" | cut -c1-8)
ws=$(basename "$PWD")

printf '\n'
printf ' \033[1mcodex\033[0m v0.48.0\n'
printf '\n'
printf '   Resuming session \033[1m%s\033[0m  -  12 messages restored\n' "${short:-unknown}"
printf '   workspace: \033[36m%s\033[0m   model: gpt-5-codex\n' "$ws"
printf '\n'
printf '   \033[2m> the redis TTL test is flaky - mock the clock instead of sleeping\033[0m\n'
printf '\n'
printf ' \033[1m>\033[0m \033[5m_\033[0m\n'

# Idle so vhs can hold the frame; the recording ends before this returns.
sleep 600
