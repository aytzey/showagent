#!/bin/sh
# Illustration stub, never a Claude loader or model response.
if [ "$#" -ne 2 ] || [ "$1" != --resume ]; then
	printf 'Demo stub: only claude --resume <id> is supported.\n' >&2
	exit 2
fi
printf '\nSIMULATED CLI OUTPUT — sample sessions\n\n'
printf 'Resume command handed to the Claude demo stub:\n  claude --resume %s\n\n' "$2"
printf 'No real agent was launched. Native resume compatibility is not verified here.\n'
